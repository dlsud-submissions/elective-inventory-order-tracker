@model Order

@{
    ViewData["Title"] = "Delete Order";
}

<div class="page-header">
    <h1 class="mb-0">Delete Order</h1>
</div>

<div class="content-card" style="max-width: 32rem;">
    <p class="fw-semibold">Are you sure you want to delete this?</p>
    <dl class="row mb-3">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CustomerEmail)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.CustomerEmail)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.OrderDate)</dt>
        <dd class="col-sm-8">@Model.OrderDate.ToString("g")</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.TotalAmount)</dt>
        <dd class="col-sm-8">@Model.TotalAmount.ToString("C")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </form>
</div>
