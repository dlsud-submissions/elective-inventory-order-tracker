@model Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="page-header">
    <h1 class="mb-0">Order Details</h1>
</div>

<div class="content-card">
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CustomerEmail)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CustomerEmail)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.OrderDate)</dt>
        <dd class="col-sm-9">@Model.OrderDate.ToString("g")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TotalAmount)</dt>
        <dd class="col-sm-9">@Model.TotalAmount.ToString("C")</dd>
    </dl>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>
